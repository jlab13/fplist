#: src/main.c:15
msgid ""
"Usage: fpl [options] [CONNECTION]\n"
"\n"
"Full Parameter List: terminal parameter editor for ArduPilot and PX4 (MAVLink).\n"
"Without CONNECTION the vehicle is auto-detected like QGroundControl does:\n"
"USB flight controllers / SiK radios, UDP :14550 and TCP 127.0.0.1:5760 (SITL).\n"
msgstr ""
"Використання: fpl [опції] [ПІДКЛЮЧЕННЯ]\n"
"\n"
"Full Parameter List: термінальний редактор параметрів ArduPilot і PX4 (MAVLink).\n"
"Без ПІДКЛЮЧЕННЯ апарат шукається автоматично, як у QGroundControl:\n"
"USB польотні контролери / SiK-радіомодеми, UDP :14550 і TCP 127.0.0.1:5760 (SITL).\n"

#: src/main.c:22
msgid ""
"CONNECTION:\n"
"  /dev/ttyACM0[:BAUD]        serial port (also serial:/dev/ttyUSB0:57600)\n"
"  udp:[HOST:]PORT            listen for UDP (e.g. udp:14550)\n"
"  udpout:HOST:PORT           send UDP to HOST:PORT (e.g. udpout:192.168.4.1:14550)\n"
"  tcp:[HOST:]PORT            TCP client (e.g. tcp:127.0.0.1:5760)\n"
msgstr ""
"ПІДКЛЮЧЕННЯ:\n"
"  /dev/ttyACM0[:ШВИДКІСТЬ]   серійний порт (також serial:/dev/ttyUSB0:57600)\n"
"  udp:[ХОСТ:]ПОРТ            слухати UDP (напр. udp:14550)\n"
"  udpout:ХОСТ:ПОРТ           надсилати UDP на ХОСТ:ПОРТ (напр. udpout:192.168.4.1:14550)\n"
"  tcp:[ХОСТ:]ПОРТ            TCP-клієнт (напр. tcp:127.0.0.1:5760)\n"

#: src/main.c:29
msgid ""
"Options:\n"
"  -b, --baud N          serial baud rate (default 115200)\n"
"  -s, --sysid N         only talk to this vehicle system id\n"
"      --gcs-sysid N     our MAVLink system id (default 255)\n"
"      --no-serial       auto-detect: do not probe serial ports\n"
"      --no-udp          auto-detect: do not listen on UDP\n"
"      --no-tcp          auto-detect: do not probe TCP (SITL)\n"
"      --udp-port N      auto-detect UDP port (default 14550)\n"
"      --tcp-port N      auto-detect TCP port (default 5760)\n"
"  -m, --meta FILE       parameter metadata (apm.pdef.xml or PX4 .json)\n"
"      --offline         never download metadata, use cache only\n"
"      --no-ftp          ArduPilot: don't download parameters via MAVFTP\n"
"                        (slower PARAM_REQUEST_LIST, no default values)\n"
"      --meta-lang LANG  PX4 metadata translation, e.g. uk_UA; en = none\n"
"                        (default: from LANGUAGE / LC_MESSAGES)\n"
"  -d, --dump            no UI: download parameters, print TSV to stdout, exit\n"
"  -t, --timeout SEC     with --dump: give up after SEC seconds (default 90)\n"
"  -l, --list            list serial ports and how they are classified\n"
"      --log FILE        write a debug log\n"
"  -V, --version         print version\n"
"  -h, --help            this help\n"
msgstr ""
"Опції:\n"
"  -b, --baud N          швидкість серійного порту (типово 115200)\n"
"  -s, --sysid N         працювати лише з апаратом із цим system id\n"
"      --gcs-sysid N     наш MAVLink system id (типово 255)\n"
"      --no-serial       автопошук: не перевіряти серійні порти\n"
"      --no-udp          автопошук: не слухати UDP\n"
"      --no-tcp          автопошук: не перевіряти TCP (SITL)\n"
"      --udp-port N      порт UDP для автопошуку (типово 14550)\n"
"      --tcp-port N      порт TCP для автопошуку (типово 5760)\n"
"  -m, --meta ФАЙЛ       метадані параметрів (apm.pdef.xml або PX4 .json)\n"
"      --offline         не завантажувати метадані, лише кеш\n"
"      --no-ftp          ArduPilot: не завантажувати параметри через MAVFTP\n"
"                        (повільніший PARAM_REQUEST_LIST, без типових значень)\n"
"      --meta-lang МОВА  переклад метаданих PX4, напр. uk_UA; en = без перекладу\n"
"                        (типово: з LANGUAGE / LC_MESSAGES)\n"
"  -d, --dump            без UI: завантажити параметри, вивести TSV і вийти\n"
"  -t, --timeout СЕК     з --dump: здатися через СЕК секунд (типово 90)\n"
"  -l, --list            показати серійні порти та їх класифікацію\n"
"      --log ФАЙЛ        писати журнал налагодження\n"
"  -V, --version         показати версію\n"
"  -h, --help            ця довідка\n"

